{
  "$comment": "Declarative contract for the version sites ISO 3166 tracks. Read by tools/check_version_consistency.py (the checker and, through --bump and --expect, the bump step of scripts/release.sh): this file is the one list. A site is bumped by release.sh when bumped is true, with the named bumper; a site with generated_by is rewritten by that generator later in the release and is not asserted at the bump.",
  "axes": [
    {
      "name": "registry",
      "source": "VERSION",
      "comment": "The registry data version. Single source of truth. Bumped on every release."
    }
  ],
  "extractors": {
    "text": {
      "comment": "The file is a single line containing only the version.",
      "arg": null
    },
    "json_path": {
      "comment": "Read a JSON file and return the value at the dotted path.",
      "arg": "dotted path, e.g. 'meta.version'"
    },
    "toml_section": {
      "comment": "Read a TOML file: a top-level key, or '<package>.<key>' for a [[package]] entry of a lockfile.",
      "arg": "key name, e.g. 'version'"
    },
    "python_regex": {
      "comment": "Match a Python file with a regex that captures the version.",
      "arg": "regex with one capture group"
    },
    "badge": {
      "comment": "Match a shields.io badge on a markdown line.",
      "arg": "badge label, e.g. 'registry'"
    },
    "first_released_heading": {
      "comment": "Read CHANGELOG.md and return the version from the first '## [x.y.z]' heading.",
      "arg": null
    },
    "parquet_footer": {
      "comment": "Read the version from the Parquet file's key-value metadata.",
      "arg": "metadata key, e.g. 'iso3166.version'"
    }
  },
  "sites": [
    {
      "name": "version-file",
      "axis": "registry",
      "path": "VERSION",
      "extractor": "text",
      "required": true,
      "bumped": true,
      "bumper": "write_text"
    },
    {
      "name": "registry-meta-version",
      "axis": "registry",
      "path": "iso3166.json",
      "extractor": "json_path",
      "extractor_arg": "meta.version",
      "required": true,
      "bumped": true,
      "bumper": "write_meta_version"
    },
    {
      "name": "changelog-heading",
      "axis": "registry",
      "path": "CHANGELOG.md",
      "extractor": "first_released_heading",
      "required": true,
      "bumped": false
    },
    {
      "name": "readme-badge",
      "axis": "registry",
      "path": "README.md",
      "extractor": "badge",
      "extractor_arg": "registry",
      "required": true,
      "bumped": true,
      "bumper": "write_badge"
    },
    {
      "name": "python-pyproject",
      "axis": "registry",
      "path": "wrappers/python/pyproject.toml",
      "extractor": "toml_section",
      "extractor_arg": "version",
      "required": true,
      "bumped": true,
      "bumper": "write_pyproject_version"
    },
    {
      "name": "python-init",
      "axis": "registry",
      "path": "wrappers/python/iso3166/__init__.py",
      "extractor": "python_regex",
      "extractor_arg": "^__version__ = \"([0-9.]+)\"",
      "required": true,
      "bumped": true,
      "bumper": "write_init_version"
    },
    {
      "name": "javascript-package",
      "axis": "registry",
      "path": "wrappers/javascript/package.json",
      "extractor": "json_path",
      "extractor_arg": "version",
      "required": true,
      "bumped": true,
      "bumper": "write_package_json"
    },
    {
      "name": "rust-cargo-toml",
      "axis": "registry",
      "path": "wrappers/rust/Cargo.toml",
      "extractor": "toml_section",
      "extractor_arg": "version",
      "required": true,
      "bumped": true,
      "bumper": "write_cargo_toml_version"
    },
    {
      "name": "rust-cargo-lock",
      "axis": "registry",
      "path": "wrappers/rust/Cargo.lock",
      "extractor": "toml_section",
      "extractor_arg": "iso3166-registry.version",
      "required": true,
      "bumped": false
    },
    {
      "name": "parquet-footer",
      "axis": "registry",
      "path": "iso3166.parquet",
      "extractor": "parquet_footer",
      "extractor_arg": "iso3166.version",
      "required": true,
      "bumped": false,
      "generated_by": "tools/export_parquet.py"
    },
    {
      "name": "registry-release-json",
      "axis": "registry",
      "path": "registry_release.json",
      "extractor": "json_path",
      "extractor_arg": "version",
      "required": true,
      "bumped": false,
      "generated_by": "tools/gen_registry_release.py"
    }
  ],
  "bumpers": {
    "write_text": "Write the version and a newline to the file.",
    "write_meta_version": "Set meta.version and meta.updated (today) in iso3166.json.",
    "write_badge": "Rewrite the registry-X.Y.Z-<colour> badge.",
    "write_pyproject_version": "Rewrite the first top-level version = \"...\" line.",
    "write_init_version": "Rewrite the __version__ = \"...\" line.",
    "write_cargo_toml_version": "Rewrite the first top-level version = \"...\" line.",
    "write_package_json": "Set the top-level version key."
  }
}
